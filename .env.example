# Copy to .env.local for local development, and set the same keys in the Vercel
# project (Settings → Environment Variables) for production.
#
# The site runs without any of these. The enquiry form validates and returns
# success, but logs instead of sending — fine locally, a misconfiguration in
# production, where the route logs an explicit error saying so.

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin. Feeds metadata, JSON-LD, sitemap.xml and robots.txt.
# Set this in Vercel. Defaults to https://proservindia.in
NEXT_PUBLIC_SITE_URL=https://proservindia.in

# ── Enquiry email ────────────────────────────────────────────────────────────
# From the Resend dashboard → API Keys. Sending permission is enough.
RESEND_API_KEY=

# Where enquiries land. Comma-separated for more than one recipient.
ENQUIRY_TO=Sales@proservindia.in

# Must be a sender on a domain verified in Resend. Until proservindia.in is
# verified, onboarding@resend.dev works for testing but is rate-limited and
# lands in spam — do not launch on it.
ENQUIRY_FROM=Proserv <enquiries@proservindia.in>

# Set to "off" to stop the buyer autoresponder without a code change.
ENQUIRY_AUTORESPONDER=on
